# GitHub token (fine-grained, public repos read-only). Without it GitHub allows 60 requests an hour.
GITHUB_TOKEN=
# AI models. Either one is enough; both lets them back each other up.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional shared cache. Without it, caching is per server instance.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://localhost:3000
# ENABLE_MOCK_MODEL=1 runs the AI features with a fake model, no keys needed.
